# Copy to .env and fill in only what you use. Never commit .env.

# ---------- LLM providers (any subset works; the router skips unconfigured ones) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, local Ollama, ...)
# is declared in config/channel.yaml under llm.compat_providers; put its key here:
OPENROUTER_API_KEY=

# ---------- Narration (video.voice.provider) ----------
# openai uses OPENAI_API_KEY above; flite needs nothing.
ELEVENLABS_API_KEY=

# --- Viral scout (vw viral) -------------------------------------------------------------
# YouTube Data API v3 key: console.cloud.google.com → enable "YouTube Data API v3" →
# Credentials → Create API key (restrict it to that API). Free quota covers the daily scout.
YOUTUBE_API_KEY=
# Optional: Apify token for TikTok / Instagram discovery (paid per run; apify.com → Settings → API)
APIFY_TOKEN=

# ---------- Higgsfield (video generation via MCP) ----------
# Only needed for the headless `higgsfield_mcp` generator. The `handoff` generator
# uses the Higgsfield MCP connector inside Claude Code and needs nothing here.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_TOKEN=

# ---------- YouTube Shorts (YouTube Data API v3, OAuth2) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------- Instagram Reels (Instagram Graph API) ----------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# graph.facebook.com (Facebook Login for Business) or graph.instagram.com (Instagram Login)
INSTAGRAM_GRAPH_HOST=graph.facebook.com
INSTAGRAM_GRAPH_VERSION=v25.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# ---------- Notifications & approvals ----------
# Telegram: create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (the bot only obeys this chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# ---------- Dashboard ----------
# Required if `vw serve` listens beyond localhost; open http://host:8787/?token=<value> once.
DASHBOARD_TOKEN=
